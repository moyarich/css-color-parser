{
  "name": "@moyarich/css-color-parser-monaco",
  "version": "0.1.0",
  "description": "Reusable React/Monaco CSS color integration powered by @moyarich/css-color-parser.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --external react --external @monaco-editor/react --external monaco-editor --external @moyarich/css-color-parser",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run build",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "@monaco-editor/react": ">=4.7.0",
    "@moyarich/css-color-parser": ">=0.1.0",
    "monaco-editor": ">=0.56.0",
    "react": ">=19.0.0"
  },
  "devDependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@moyarich/css-color-parser": "file:../css-color-parser",
    "@types/react": "^19.1.16",
    "monaco-editor": "^0.56.0",
    "react": "^19.1.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moyarich/css-color-parser.git",
    "directory": "packages/css-color-parser-monaco"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "bugs": {
    "url": "https://github.com/moyarich/css-color-parser/issues"
  },
  "homepage": "https://moyarich.github.io/css-color-parser/",
  "keywords": [
    "css",
    "css-color",
    "css-color-parser",
    "monaco",
    "monaco-editor",
    "react",
    "editor",
    "color-provider",
    "color-decorators",
    "typescript",
    "developer-tools"
  ]
}
