{
  "name": "@moyarich/css-color-parser-playground",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:workspace-deps": "npm --prefix ../.. run build:packages",
    "predev": "npm run prepare:workspace-deps",
    "dev": "vite",
