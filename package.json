{
  "name": "css-color-parser-monorepo",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "dev": "npm run dev:playground",
    "dev:playground": "npm run dev --workspace @moyarich/css-color-parser-playground",
    "build": "npm run build --workspace @moyarich/css-color-parser",
    "build:playground": "npm run build --workspace @moyarich/css-color-parser-playground",
    "typecheck": "npm run typecheck --workspace @moyarich/css-color-parser",
    "test": "npm test --workspace @moyarich/css-color-parser",
    "test:watch": "npm run test:watch --workspace @moyarich/css-color-parser",
    "check": "npm run check --workspaces --if-present"
  }
}
